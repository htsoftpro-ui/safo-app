# Safo static deployment: avoid stale HTML while preserving browser caching for assets.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|json)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

RewriteEngine On
# Pretty supplier URLs are redirected to the hash-router routes used by the Vue app.
RewriteRule ^supplier/(login|orders|products|profile)(?:/.*)?/?$ /supplier/#/$1 [R=302,L,NE]
