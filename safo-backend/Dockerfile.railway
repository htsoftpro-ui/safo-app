FROM php:8.2-fpm-alpine

RUN apk add --no-cache nginx supervisor curl libpng-dev oniguruma-dev libxml2-dev icu-dev zip unzip libzip-dev

RUN docker-php-ext-install pdo_mysql mbstring xml bcmath zip gd intl opcache pcntl

RUN apk add --no-cache $PHPIZE_DEPS && pecl install redis && docker-php-ext-enable redis

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
COPY . .

RUN composer install --no-dev --optimize-autoloader --no-interaction

RUN chown -R www-data:www-data storage bootstrap/cache && chmod -R 775 storage bootstrap/cache

EXPOSE ${PORT:-8000}

CMD sh -c "php artisan config:cache && php artisan route:cache && php artisan migrate --force && php artisan db:seed --force && php -S 0.0.0.0:${PORT:-8000} -t public"
