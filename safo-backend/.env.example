APP_NAME=Safo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Aden
APP_URL=http://localhost:8000

# Arabic first, English second
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

# Database — MySQL 8.0
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=safo
DB_USERNAME=root
DB_PASSWORD=

# Cache & Sessions — Redis
BROADCAST_CONNECTION=redis
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — configure per environment
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@safo.app"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum — JWT token lifetime in minutes (7 days = 10080)
SANCTUM_TOKEN_EXPIRATION=10080

# Firebase — Push Notifications
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# File Upload Limits
MAX_UPLOAD_SIZE=5120
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# Supplier Defaults
DEFAULT_DELIVERY_FEE=500
FREE_DELIVERY_THRESHOLD=10000
DEFAULT_CURRENCY=YER
DEFAULT_CURRENCY_SYMBOL=﷼
